+    <script>
+    // UI-only helper for the tooling add modal.
+    // It does not replace tooling-modal.js. It only changes labels/visibility for ring tooling
+    // and keeps the hidden Z depth synchronized with the visible diameter field.
+    (function () {
+        function getSelectedToolingCard() {
+            return document.querySelector('#tooling-type-cards .tooling-type-card.selected');
+        }
+
+        function selectedToolingLooksLikeRing() {
+            const card = getSelectedToolingCard();
+            if (!card) return false;
+            const dataText = Object.entries(card.dataset || {})
+                .map(([k, v]) => `${k}:${v}`)
+                .join(' ');
+            const text = `${dataText} ${card.getAttribute('data-tooling-type') || ''} ${card.getAttribute('data-type') || ''} ${card.textContent || ''}`;
+            return /ring-tooling|ringnode|ring|环形/i.test(text);
+        }
+
+        function setText(id, value) {
+            const el = document.getElementById(id);
+            if (el) el.textContent = value;
+        }
+
+        function syncRingDepth() {
+            if (!document.body.classList.contains('tooling-add-ring-mode')) return;
+            const width = document.getElementById('ta-width');
+            const depth = document.getElementById('ta-depth');
+            if (width && depth) depth.value = width.value;
+        }
+
+        function syncToolingAddModalMode() {
+            const isRing = selectedToolingLooksLikeRing();
+            document.body.classList.toggle('tooling-add-ring-mode', isRing);
+
+            if (isRing) {
+                setText('ta-width-label', '外径 D mm');
+                setText('ta-height-label', '高度 H mm');
+                setText('ta-depth-label', '等效外径 Z mm');
+                syncRingDepth();
+                const nameInput = document.getElementById('ta-name');
+                if (nameInput && !nameInput.value.trim()) nameInput.value = '环形工装';
+                return;
+            }
+
+            setText('ta-width-label', '宽度 X mm');
+            setText('ta-height-label', '高度 Y mm');
+            setText('ta-depth-label', '纵深 Z mm');
+        }
+
+        document.addEventListener('click', function (event) {
+            if (event.target.closest('#tooling-type-cards .tooling-type-card')) {
+                setTimeout(syncToolingAddModalMode, 0);
+            }
+        });
+
+        document.addEventListener('input', function (event) {
+            if (event.target && event.target.id === 'ta-width') syncRingDepth();
+        });
+
+        const observer = new MutationObserver(syncToolingAddModalMode);
+        document.addEventListener('DOMContentLoaded', function () {
+            const cards = document.getElementById('tooling-type-cards');
+            const overlay = document.getElementById('tooling-add-overlay');
+            if (cards) observer.observe(cards, { childList: true, subtree: true, attributes: true, attributeFilter: ['class', 'data-tooling-type', 'data-type'] });
+            if (overlay) observer.observe(overlay, { attributes: true, attributeFilter: ['class', 'style'] });
+            syncToolingAddModalMode();
+        });
+    })();
+    </script>
